{
  "name": "leadrankpilot/wordpress-plugin",
  "description": "LeadRankPilot WordPress connector plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.7",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "LeadRankPilot\\Plugin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LeadRankPilot\\Plugin\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse src --level=6",
    "phpcs": "phpcs --standard=phpcs.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
